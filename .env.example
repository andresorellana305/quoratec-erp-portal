# Variables de entorno Cloudflare Pages / Edge Functions — TributaFlow ERP v3.0.0 (QUORATEC)
# No incluyas credenciales reales en el repositorio.

# --- Supabase (Auth + Base de Órdenes y Licencias) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguridad Criptográfica Edge ---
LICENSE_HMAC_SECRET=
ORDER_TOKEN_SECRET=

# --- Pasarela Activa Actual: Deuna! Personal / Transferencia Directa ---
DEUNA_PERSONAL_ENABLED=true
TRANSFERENCIA_ENABLED=true

# --- Feature Flag: Deuna! Negocios API (Próximamente) ---
FF_DEUNA_NEGOCIOS_ENABLED=false
DEUNA_BUSINESS_API_KEY=
DEUNA_BUSINESS_CLIENT_ID=
DEUNA_BUSINESS_SECRET=
DEUNA_WEBHOOK_SECRET=

# --- Feature Flag: PayPhone Business (Próximamente / En actualización) ---
FF_PAYPHONE_BUSINESS_ENABLED=false
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_WEBHOOK_SECRET=

# --- Rate Limiting ---
TF_RATE_LIMIT_MAX=25
TF_RATE_WINDOW_MS=60000
